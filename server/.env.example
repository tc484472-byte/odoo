# ==============================================================================
# BRIGHTLOOP SUBSCRIPTION MANAGEMENT SYSTEM - SERVER CONFIGURATION
# ==============================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection (Supabase Free Tier or Local Postgres)
# Leave empty to automatically use the embedded In-Memory PostgreSQL engine
DATABASE_URL=

# Authentication Secret
JWT_SECRET=brightloop_super_secret_jwt_key_2026_odoo_hackathon
JWT_EXPIRES_IN=7d

# Application Timezone
TZ=Asia/Kolkata

# Optional Free Email Delivery (Nodemailer / Ethereal / Sendgrid / Resend)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL="Brightloop Billing <billing@brightloop.com>"

# Automation Security Key (For GitHub Actions / External Cron Triggers)
CRON_SECRET=brightloop_cron_secret_hackathon_2026
